<?xml version="1.0"?>
<ruleset name="Cemeti theme">
	<description>WordPress coding standards for the Cemeti theme. Run: composer lint</description>

	<file>themes/scriptmedia-cemeti</file>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_supported_wp_version" value="6.6"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="cemeti"/>
				<element value="CEMETI"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="scriptmedia-cemeti"/>
			</property>
		</properties>
	</rule>

	<!-- The theme is written with aligned arrays and short closures: keep the signal, drop the noise. -->
	<rule ref="Generic.Formatting.MultipleStatementAlignment"><severity>0</severity></rule>
	<rule ref="WordPress.Arrays.MultipleStatementAlignment"><severity>0</severity></rule>
	<rule ref="Universal.Operators.DisallowShortTernary"><severity>0</severity></rule>
</ruleset>
