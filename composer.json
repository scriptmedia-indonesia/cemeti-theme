{
  "name": "scriptmedia/cemeti-theme",
  "description": "Standalone WordPress theme for Cemeti – Institut untuk Seni dan Masyarakat (development tooling only; the theme itself has no dependencies).",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "scripts": {
    "test": "bash tests/run.sh",
    "test:quick": "bash tests/run.sh --no-browser",
    "lint": "phpcs --standard=phpcs.xml.dist",
    "lint:fix": "phpcbf --standard=phpcs.xml.dist",
    "build": "bash scripts/build-zip.sh"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
